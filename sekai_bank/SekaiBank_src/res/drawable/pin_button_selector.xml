<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pin_button_pressed" />
            <corners android:radius="12.0dip" />
            <stroke android:width="1.0dip" android:color="@color/sekai_pink_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pin_button_normal" />
            <corners android:radius="12.0dip" />
            <stroke android:width="1.0dip" android:color="@color/sekai_pink_primary" />
        </shape>
    </item>
</selector>